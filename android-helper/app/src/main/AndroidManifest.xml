<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      No INTERNET permission: this app never opens a network socket itself.
      It only talks to the Shizuku service over local IPC (Binder) to run a
      shell command, and to the proxy target device (this same phone) via
      Settings.Global — both are local, not networked.
    -->

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.OemUnlockHelper"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          dev.rikka.shizuku:provider supplies its own ShizukuProvider
          <provider> entry via manifest merging — nothing to declare here.
        -->
    </application>

</manifest>
